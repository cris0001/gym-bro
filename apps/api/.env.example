# Copy to .env and fill in real values. Never commit .env (gitignored).
# Local dev reads this file via tsx --env-file; in production these are set as
# Fly secrets (`fly secrets set ...`) and read from process.env.

# Server. PORT is local-dev only — in the container it's set to 8080 by the
# Dockerfile / fly.toml.
PORT=3000
# 'development' locally; NODE_ENV=production is baked into the image in prod
# (enables the Secure auth cookie, which HTTPS requires).
NODE_ENV=development

# PostgreSQL connection string (Neon serverless, free tier).
# Format: postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
# In production use the Neon POOLED connection string (host contains "-pooler"):
# the server uses the WebSocket Pool driver (interactive transactions). Get it from
# Neon → Connection Details → "Pooled connection".
DATABASE_URL=

# Secret used to sign JWTs (jose). Use a long random string in production,
# e.g. `openssl rand -base64 32`.
JWT_SECRET=

# Origin allowed by CORS (auth uses an HttpOnly cookie with credentials).
# Local: the Vite dev server. In production the API is same-origin with the SPA
# (one Fly app serves both), so set this to your deployed URL,
# e.g. https://your-app.fly.dev
CORS_ORIGIN=http://localhost:5173

# --- Strava integration (optional) ---
# Leave all three blank to run without Strava; set them TOGETHER once you've
# registered the Strava API app (https://www.strava.com/settings/api).
# The Client ID is public (appears in the authorize URL); keep the Client Secret
# private. STRAVA_REDIRECT_URI must live under the "Authorization Callback Domain"
# you set on the Strava app (Strava validates the domain, not the path).
#   Local: http://localhost:3000/api/strava/callback   (callback domain: localhost)
#   Prod:  https://your-app.fly.dev/api/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
